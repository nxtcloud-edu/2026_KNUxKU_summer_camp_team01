{
  "title": "PlanToVerificationInput",
  "description": "Plan Agent가 완성한 plan을 검증 Agent에 전달하는 입력 스키마",
  "type": "object",
  "additionalProperties": false,
  "required": ["trip_info", "plan"],
  "properties": {
    "trip_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "start_date",
        "end_date",
        "num_travelers",
        "budget_total",
        "budget_currency",
        "budget_includes",
        "transport_mode",
        "day_start_time",
        "day_end_time",
        "persona"
      ],
      "properties": {
        "destination": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "num_travelers": {
          "type": "integer",
          "minimum": 1
        },
        "budget_total": {
          "type": "number",
          "minimum": 0
        },
        "budget_currency": {
          "type": "string"
        },
        "budget_includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transport_mode": {
          "type": "string"
        },
        "day_start_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "day_end_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "persona": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "must_visit",
            "avoid",
            "pace",
            "max_walking_level"
          ],
          "properties": {
            "description": {
              "type": "string"
            },
            "must_visit": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pace": {
              "type": "string"
            },
            "max_walking_level": {
              "type": "string"
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "date", "items"],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "category",
                    "start_time",
                    "end_time",
                    "lat",
                    "lng",
                    "price",
                    "price_unit",
                    "opening_hours",
                    "closed_days",
                    "expected_duration_min",
                    "physical_intensity",
                    "note",
                    "travel_from_prev"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^d[1-9]\\d*-[1-9]\\d*$"
                    },
                    "name": {
                      "type": "string"
                    },
                    "category": {
                      "enum": ["관광지", "식사", "카페", "쇼핑", "휴식", "숙소"]
                    },
                    "start_time": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "end_time": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "lng": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "price": {
                      "type": "number",
                      "minimum": 0
                    },
                    "price_unit": {
                      "enum": ["per_person", "per_stay"]
                    },
                    "opening_hours": {
                      "type": "string"
                    },
                    "closed_days": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected_duration_min": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "physical_intensity": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "travel_from_prev": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["mode", "estimated_min", "distance_km"],
                          "properties": {
                            "mode": {
                              "type": "string"
                            },
                            "estimated_min": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "distance_km": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
