{
  "title": "PlanToVerificationInput",
  "description": "Plan Agent가 완성한 plan을 Verification Agent에 전달하는 canonical handoff 계약",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trip_info", "plan"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "trip_info": { "$ref": "#/$defs/TripInfo" },
    "plan": { "$ref": "#/$defs/Plan" }
  },
  "$defs": {
    "Date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "Time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "Currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "Category": { "enum": ["관광지", "식사", "카페", "쇼핑", "휴식", "숙소"] },
    "BudgetCategory": { "enum": ["관광지", "식사", "카페", "쇼핑", "휴식", "숙소"] },
    "WalkingLevel": { "enum": ["낮음", "중", "중간", "높음"] },
    "Persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "must_visit", "avoid", "pace", "max_walking_level"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "must_visit": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "avoid": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "pace": { "enum": ["여유", "보통", "빡빡"] },
        "max_walking_level": { "$ref": "#/$defs/WalkingLevel" }
      }
    },
    "TripInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "start_date", "end_date", "num_travelers", "budget_total", "budget_currency", "budget_includes", "transport_mode", "day_start_time", "day_end_time", "persona"],
      "properties": {
        "destination": { "type": "string", "minLength": 1 },
        "start_date": { "$ref": "#/$defs/Date" },
        "end_date": { "$ref": "#/$defs/Date" },
        "num_travelers": { "type": "integer", "minimum": 1 },
        "budget_total": { "type": "number", "minimum": 0 },
        "budget_currency": { "$ref": "#/$defs/Currency" },
        "budget_includes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/BudgetCategory" } },
        "transport_mode": { "type": "string", "minLength": 1 },
        "day_start_time": { "$ref": "#/$defs/Time" },
        "day_end_time": { "$ref": "#/$defs/Time" },
        "persona": { "$ref": "#/$defs/Persona" }
      }
    },
    "TravelFromPrevious": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "estimated_min", "distance_km"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "estimated_min": { "type": "integer", "minimum": 0 },
        "distance_km": { "type": "number", "minimum": 0 }
      }
    },
    "PlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "start_time", "end_time", "lat", "lng", "price", "price_unit", "opening_hours", "closed_days", "expected_duration_min", "physical_intensity", "note", "travel_from_prev"],
      "properties": {
        "id": { "type": "string", "pattern": "^d[1-9]\\d*-[1-9]\\d*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/Category" },
        "start_time": { "$ref": "#/$defs/Time" },
        "end_time": { "$ref": "#/$defs/Time" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "price": { "type": "number", "minimum": 0 },
        "price_unit": { "enum": ["per_person", "per_stay"] },
        "opening_hours": { "type": "string", "minLength": 1 },
        "closed_days": { "type": "array", "uniqueItems": true, "items": { "enum": ["월요일", "화요일", "수요일", "목요일", "금요일", "토요일", "일요일"] } },
        "expected_duration_min": { "type": "integer", "minimum": 0 },
        "physical_intensity": { "$ref": "#/$defs/WalkingLevel" },
        "note": { "type": "string" },
        "travel_from_prev": { "oneOf": [{ "$ref": "#/$defs/TravelFromPrevious" }, { "type": "null" }] }
      }
    },
    "PlanDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "date", "items"],
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "date": { "$ref": "#/$defs/Date" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PlanItem" } }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PlanDay" } }
      }
    }
  }
}
