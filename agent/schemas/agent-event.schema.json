{
  "title": "AgentEvent",
  "description": "에이전트가 SSE data 필드로 보내는 공통 전송 이벤트. Handoff payload 계약과 분리한다.",
  "type": "object",
  "required": ["seq", "at", "type"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0 },
    "at": { "type": "integer", "minimum": 0 },
    "type": { "enum": ["status", "progress", "done", "error"] }
  },
  "oneOf": [
    { "$ref": "#/$defs/StatusEvent" },
    { "$ref": "#/$defs/ProgressEvent" },
    { "$ref": "#/$defs/DoneEvent" },
    { "$ref": "#/$defs/ErrorEvent" }
  ],
  "$defs": {
    "Base": {
      "type": "object",
      "required": ["seq", "at", "type"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "integer", "minimum": 0 }
      }
    },
    "StatusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "at", "type", "text"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "integer", "minimum": 0 },
        "type": { "const": "status" },
        "text": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "ProgressEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "at", "type", "value"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "integer", "minimum": 0 },
        "type": { "const": "progress" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "DoneEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "at", "type", "payload"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "integer", "minimum": 0 },
        "type": { "const": "done" },
        "payload": { "type": ["object", "array"] },
        "summary": { "type": "string", "maxLength": 200 }
      }
    },
    "ErrorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "at", "type", "code", "message", "retryable"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "integer", "minimum": 0 },
        "type": { "const": "error" },
        "code": { "enum": ["invalid_input", "timeout", "rate_limit", "agent_failed"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
