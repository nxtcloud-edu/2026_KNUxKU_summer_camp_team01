{
  "title": "SearchToPlanInput",
  "description": "Search Agent가 선택된 검색 결과와 여행 조건을 Plan Agent에 전달하는 canonical handoff 계약",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trip_info", "selected"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "trip_info": { "$ref": "#/$defs/TripInfo" },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flight", "stay", "places"],
      "properties": {
        "flight": { "oneOf": [{ "$ref": "#/$defs/SelectedFlight" }, { "type": "null" }] },
        "stay": { "oneOf": [{ "$ref": "#/$defs/SelectedStay" }, { "type": "null" }] },
        "places": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SelectedPlace" } }
      }
    }
  },
  "$defs": {
    "Date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "Time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "Currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "Category": { "enum": ["관광지", "식사", "카페", "쇼핑", "휴식", "숙소"] },
    "BudgetCategory": { "enum": ["관광지", "식사", "카페", "쇼핑", "휴식", "숙소"] },
    "WalkingLevel": { "enum": ["낮음", "중", "중간", "높음"] },
    "Persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "must_visit", "avoid", "pace", "max_walking_level"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "must_visit": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "avoid": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "pace": { "enum": ["여유", "보통", "빡빡"] },
        "max_walking_level": { "$ref": "#/$defs/WalkingLevel" }
      }
    },
    "TripInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "start_date", "end_date", "num_travelers", "budget_total", "budget_currency", "budget_includes", "transport_mode", "day_start_time", "day_end_time", "persona"],
      "properties": {
        "destination": { "type": "string", "minLength": 1 },
        "start_date": { "$ref": "#/$defs/Date" },
        "end_date": { "$ref": "#/$defs/Date" },
        "num_travelers": { "type": "integer", "minimum": 1 },
        "budget_total": { "type": "number", "minimum": 0 },
        "budget_currency": { "$ref": "#/$defs/Currency" },
        "budget_includes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/BudgetCategory" } },
        "transport_mode": { "type": "string", "minLength": 1 },
        "day_start_time": { "$ref": "#/$defs/Time" },
        "day_end_time": { "$ref": "#/$defs/Time" },
        "persona": { "$ref": "#/$defs/Persona" }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "$ref": "#/$defs/Currency" }
      }
    },
    "TravelLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depart_at", "arrive_at", "duration_min"],
      "properties": {
        "depart_at": { "type": "string", "minLength": 16 },
        "arrive_at": { "type": "string", "minLength": 16 },
        "duration_min": { "type": "integer", "minimum": 0 }
      }
    },
    "SelectedFlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outbound", "inbound", "total_price"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "outbound": { "$ref": "#/$defs/TravelLeg" },
        "inbound": { "oneOf": [{ "$ref": "#/$defs/TravelLeg" }, { "type": "null" }] },
        "total_price": { "$ref": "#/$defs/Money" }
      }
    },
    "SelectedStay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lat", "lng", "price", "price_unit", "check_in_time", "check_out_time", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "price": { "type": "number", "minimum": 0 },
        "price_unit": { "const": "per_stay" },
        "check_in_time": { "$ref": "#/$defs/Time" },
        "check_out_time": { "$ref": "#/$defs/Time" },
        "note": { "type": "string" }
      }
    },
    "SelectedPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "lat", "lng", "price", "price_unit", "opening_hours", "closed_days", "expected_duration_min", "physical_intensity", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/Category" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "price": { "type": "number", "minimum": 0 },
        "price_unit": { "enum": ["per_person", "per_stay"] },
        "opening_hours": { "type": "string", "minLength": 1 },
        "closed_days": { "type": "array", "uniqueItems": true, "items": { "enum": ["월요일", "화요일", "수요일", "목요일", "금요일", "토요일", "일요일"] } },
        "expected_duration_min": { "type": "integer", "minimum": 0 },
        "physical_intensity": { "$ref": "#/$defs/WalkingLevel" },
        "note": { "type": "string" }
      }
    }
  }
}
