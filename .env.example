# Next.js backend and frontend
AGENT_STREAM_DELAY_MS=180
AGENT_MODE=mock
SUPERVISOR_AGENT_URL=http://127.0.0.1:8000
VERIFICATION_AGENT_URL=http://127.0.0.1:8003
AGENT_HARD_TIMEOUT_MS=180000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared agent API keys
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=

# Agent models and provider limits
SEARCH_PROVIDER_MODE=hybrid
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CITY_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
SERPAPI_MAX_ROUND_TRIP_LOOKUPS=3
SERPAPI_FORCE_FRESH=true

# Google Routes controls
ROUTES_TIMEOUT_S=8
ROUTES_CACHE=on
ROUTES_ENABLED=on
ROUTES_MAX_CALLS_TOTAL=200
ROUTES_MAX_CALLS_PER_REQUEST=30

# Local service ports and timeouts
PLAN_AGENT_PORT=8001
SEARCH_AGENT_PORT=8002
VERIFICATION_AGENT_PORT=8003
PLAN_AGENT_TIMEOUT_MS=60000
SEARCH_AGENT_TIMEOUT_MS=120000
VERIFICATION_AGENT_TIMEOUT_MS=45000

# Supervisor orchestration
SEARCH_AGENT_URL=http://127.0.0.1:8002
PLAN_AGENT_URL=http://127.0.0.1:8001
VERIFICATION_AGENT_URL=http://127.0.0.1:8003
SUPERVISOR_AUTO_REPLAN=1
SUPERVISOR_MAX_REISSUE=1
LOG_LEVEL=info
