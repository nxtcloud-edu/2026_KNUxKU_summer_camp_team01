# Voyagent Search Agent 환경변수 예제
# 이 파일에는 실제 API 키를 입력하거나 커밋하지 마세요.
# 로컬에서는 루트 .env 파일의 각 = 기호 뒤에 실제 값을 입력하세요.

# Google Places API (New)
# 서버 전용 키입니다. NEXT_PUBLIC_ 같은 공개 접두사를 붙이지 마세요.
GOOGLE_PLACES_API_KEY=

# SerpApi Google Flights Results API
# https://serpapi.com/manage-api-key 에서 발급받은 서버 전용 키를 입력하세요.
SERPAPI_API_KEY=

# Gemini Google Search grounding — 도시정보 전용 DB API 대신 에이전트가 웹을 조사합니다.
# 발급 안내: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
GEMINI_CITY_MODEL=gemini-3.5-flash

# 왕복은 초기 검색 1회 + 출국편별 귀국 조회가 과금될 수 있습니다.
SERPAPI_MAX_ROUND_TRIP_LOOKUPS=3
# true이면 SerpApi 캐시를 우회해 최신 가격을 조회합니다.
SERPAPI_FORCE_FRESH=true
