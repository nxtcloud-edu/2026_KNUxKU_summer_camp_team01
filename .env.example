# Voyagent 에이전트 환경변수 템플릿
#
# 사용법
#   1. 이 파일을 `.env`로 복사한다        cp .env.example .env
#   2. 아래 "채워야 하는 값" 두 개만 채운다
#   3. 나머지는 건드리지 않아도 동작한다
#
# `.env`는 .gitignore로 제외되어 커밋되지 않는다. 이 템플릿만 커밋된다.
# 세 에이전트(plan / search / verification)가 이 파일 하나를 공유한다.


# ═══════════════════════════════════════════════════════════════
#  채워야 하는 값 — 여기 두 개만 채우면 된다
# ═══════════════════════════════════════════════════════════════

# Google Maps Platform API 키.
#
# 콘솔에서 사용 설정할 API는 "Routes API" 하나뿐이다.
#   https://console.cloud.google.com/apis/library/routes.googleapis.com
#
# Geocoding·Places·Maps JavaScript API는 필요 없다. 장소 좌표는 Search Agent가
# 이미 넘겨주기 때문이다. 레거시 Distance Matrix / Directions API도 쓰지 않는다
# (Routes API가 후속 API다).
#
# 비워두면 서버는 정상 기동하고, 이동시간을 좌표 기반으로 추정한다.
# 추정을 썼다는 사실은 서버 로그에 남는다.
GOOGLE_MAPS_API_KEY=

# Gemini API 키. https://aistudio.google.com/apikey
#
# 비워두면 Plan Agent는 결정론 배치 + 템플릿 문장으로 동작하고,
# Verification Agent는 주관 항목(avoid/pace/walking_level)을 skipped로 둔다.
GEMINI_API_KEY=


# ═══════════════════════════════════════════════════════════════
#  기본값으로 두어도 되는 값
# ═══════════════════════════════════════════════════════════════

# ── Gemini ──
# 모델명은 변경 주기가 짧다. 호출이 404로 실패하면 이 값을 먼저 확인한다.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# ── Google Routes API ──
ROUTES_TIMEOUT_S=8

# off로 두면 같은 구간을 매번 다시 조회한다(과금 증가). 디버깅할 때만 끈다.
ROUTES_CACHE=on

# ── 과금 방어선 ──
# Routes API는 유료다(월 무료 크레딧 안에서 쓰는 것이 목표).
# 아래 상한은 코드가 강제한다. 넘으면 호출하지 않고 좌표 기반 추정으로
# 대체하며 그 사실을 로그에 남긴다.
#
# off로 두면 호출을 아예 하지 않는다. 과금이 전혀 없어야 할 때 쓴다
# (발표 리허설, CI, 대량 테스트).
ROUTES_ENABLED=on

# 서버가 살아있는 동안의 누적 호출 상한. 무한 루프의 최후 방어선.
ROUTES_MAX_CALLS_TOTAL=200

# 일정 하나를 만들 때 쓸 수 있는 호출 수.
# 5일 일정의 이동 구간이 20개 정도이므로 30이면 넉넉하다.
ROUTES_MAX_CALLS_PER_REQUEST=30

# ── 서버 ──
# 세 에이전트가 서로 다른 포트를 쓴다.
PLAN_AGENT_PORT=8001
SEARCH_AGENT_PORT=8002
VERIFICATION_AGENT_PORT=8003

# 하드 상한. 이 시각에 도달하면 error 이벤트를 보내고 정상 종료한다.
# 전체 파이프라인(Search -> Plan -> Verification) 예산이며 supervisor만 해석한다.
AGENT_HARD_TIMEOUT_MS=40000

# Plan Agent 자신의 작업 상한. 전체 예산 중 Plan에 할당된 몫이다.
PLAN_AGENT_TIMEOUT_MS=20000

# ── 재계획 (검증 피드백 반영) ──
# 검증에서 possible:false가 나오면 자동으로 이 횟수만큼 다시 계획한다.
# 그 뒤로는 사용자가 요청할 때만 다시 한다 (횟수 제한 없음).
# 사용자가 수락하면 그대로 넘어간다.
SUPERVISOR_AUTO_REPLAN=1

# 하위 산출물이 계약을 어겼을 때 반송하는 횟수 상한.
SUPERVISOR_MAX_REISSUE=1

# debug / info / warning / error
LOG_LEVEL=info
