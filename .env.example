# SSE event pacing in milliseconds (0-2000). Keep unset in production for the default.
AGENT_STREAM_DELAY_MS=180

# Use live to proxy itinerary generation and verification to the local integrated agents.
AGENT_MODE=mock
SUPERVISOR_AGENT_URL=http://127.0.0.1:8000
VERIFICATION_AGENT_URL=http://127.0.0.1:8003
AGENT_HARD_TIMEOUT_MS=45000
GOOGLE_MAPS_API_KEY=
# Google Maps JavaScript API key used to render interactive maps (MapPanel) and
# the place detail embed. Create one at https://console.cloud.google.com/google/maps-apis
# and enable the "Maps JavaScript API". Restrict it to your domain(s) in production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
