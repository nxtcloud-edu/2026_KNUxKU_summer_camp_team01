# Voyagent 에이전트 환경변수 템플릿
#
# 사용법
#   1. 이 파일을 `.env`로 복사한다
#   2. 사용할 실제 연동의 API 키를 채운다
#   3. 나머지는 기본값으로 두어도 동작한다
#
# `.env`는 .gitignore로 제외되어 커밋되지 않는다. 이 템플릿만 커밋된다.
# Search / Plan / Verification Agent가 이 파일 하나를 공유한다.


# ═══════════════════════════════════════════════════════════════
#  API 키 — 실제 연동을 사용할 때 채운다
# ═══════════════════════════════════════════════════════════════

# Google Maps Platform API 키.
# Plan Agent의 이동시간 계산에는 Routes API를 사용한다.
# https://console.cloud.google.com/apis/library/routes.googleapis.com
# 비워두면 이동시간을 좌표 기반으로 추정한다.
GOOGLE_MAPS_API_KEY=

# Google Places API (New). Search Agent의 숙소·장소 검색에 사용한다.
# 서버 전용 키이며 NEXT_PUBLIC_ 같은 공개 접두사를 붙이지 않는다.
GOOGLE_PLACES_API_KEY=

# SerpApi Google Flights Results API. Search Agent의 항공편 검색에 사용한다.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Gemini API 키. 세 에이전트가 공유한다.
# https://aistudio.google.com/apikey
# 비워두면 Plan Agent는 결정론 배치 + 템플릿 문장으로 동작하고,
# Verification Agent는 주관 항목을 skipped로 두며 Search Agent의 cityInfo 웹 조사는 비활성화된다.
GEMINI_API_KEY=


# ═══════════════════════════════════════════════════════════════
#  기본값으로 두어도 되는 값
# ═══════════════════════════════════════════════════════════════

# ── Gemini ──
# 모델명은 변경 주기가 짧다. 호출이 404로 실패하면 이 값을 먼저 확인한다.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CITY_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2

# ── Search Agent ──
# 왕복은 초기 검색 1회 + 출국편별 귀국 조회가 과금될 수 있다.
SERPAPI_MAX_ROUND_TRIP_LOOKUPS=3
# true이면 SerpApi 캐시를 우회해 최신 가격을 조회한다.
SERPAPI_FORCE_FRESH=true

# ── Google Routes API ──
ROUTES_TIMEOUT_S=8

# off로 두면 같은 구간을 매번 다시 조회한다(과금 증가). 디버깅할 때만 끈다.
ROUTES_CACHE=on

# ── 과금 방어선 ──
# Routes API는 유료다. 아래 상한을 넘으면 좌표 기반 추정으로 대체한다.
# off로 두면 호출을 아예 하지 않는다.
ROUTES_ENABLED=on

# 서버가 살아있는 동안의 누적 호출 상한.
ROUTES_MAX_CALLS_TOTAL=200

# 일정 하나를 만들 때 쓸 수 있는 호출 수.
ROUTES_MAX_CALLS_PER_REQUEST=30

# ── 서버 ──
PLAN_AGENT_PORT=8001
SEARCH_AGENT_PORT=8002
VERIFICATION_AGENT_PORT=8003

# 전체 파이프라인(Search -> Plan -> Verification) 하드 상한.
AGENT_HARD_TIMEOUT_MS=40000

# Plan Agent 자신의 작업 상한.
PLAN_AGENT_TIMEOUT_MS=20000

# ── 재계획 (검증 피드백 반영) ──
# 검증에서 possible:false가 나오면 자동으로 이 횟수만큼 다시 계획한다.
SUPERVISOR_AUTO_REPLAN=1

# 하위 산출물이 계약을 어겼을 때 반송하는 횟수 상한.
SUPERVISOR_MAX_REISSUE=1

# debug / info / warning / error
LOG_LEVEL=info
